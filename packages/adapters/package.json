{
  "name": "@richardmcquiston01/chat-and-react-adapters",
  "version": "0.11.0",
  "description": "Optional input, output, and error-log adapters (webhook, WebSocket, MongoDB, MySQL, EventEmitter) for chat-and-react.",
  "license": "Apache-2.0",
  "author": "Richard McQuiston <richard.mcquiston01@gmail.com>",
  "homepage": "https://github.com/RichardMcQuiston01/chat-and-react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RichardMcQuiston01/chat-and-react.git",
    "directory": "packages/adapters"
  },
  "bugs": {
    "url": "https://github.com/RichardMcQuiston01/chat-and-react/issues"
  },
  "keywords": [
    "chat",
    "form",
    "adapter",
    "webhook",
    "websocket",
    "mongodb",
    "mysql",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "bun run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@richardmcquiston01/chat-and-react-core": "workspace:*",
    "@richardmcquiston01/error-log-adapter": "^0.2.0",
    "@richardmcquiston01/storage-adapters": "^0.5.0"
  },
  "peerDependencies": {
    "mongodb": ">=5.0.0",
    "mysql2": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "mongodb": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "mongodb": "^6.0.0",
    "mysql2": "^3.0.0",
    "tsup": "^8.5.1",
    "vitest": "^1.6.0"
  }
}
