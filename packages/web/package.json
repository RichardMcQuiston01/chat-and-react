{
  "name": "@richardmcquiston01/chat-and-react",
  "version": "0.12.1",
  "description": "A framework-agnostic Web Component that renders a chat-style form interface from a JSON schema, with branching logic and pluggable adapters.",
  "license": "Apache-2.0",
  "funding": {
    "type": "individual",
    "url": "https://donate.stripe.com/00w5kD3Gj1Xo9v7gVOcs800"
  },
  "author": "Richard McQuiston <richard.mcquiston01@gmail.com>",
  "homepage": "https://github.com/RichardMcQuiston01/chat-and-react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RichardMcQuiston01/chat-and-react.git",
    "directory": "packages/web"
  },
  "bugs": {
    "url": "https://github.com/RichardMcQuiston01/chat-and-react/issues"
  },
  "keywords": [
    "chat",
    "form",
    "conversational-form",
    "web-component",
    "custom-element",
    "json-schema",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "bun run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@richardmcquiston01/chat-and-react-core": "workspace:*"
  },
  "devDependencies": {
    "@richardmcquiston01/storage-adapters": "^0.5.0",
    "happy-dom": "^14.0.0",
    "tsup": "^8.5.1",
    "vitest": "^1.6.0"
  }
}
